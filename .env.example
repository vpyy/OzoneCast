# =============================================================================
#  OzoneCast — Root Environment Variables
#  Sao chép file này: cp .env.example .env  rồi điền giá trị thật
# =============================================================================

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ozone_db
POSTGRES_PORT=5432

# ── NASA Earthdata Credentials ────────────────────────────────────────────────
# Đăng ký tài khoản miễn phí tại: https://urs.earthdata.nasa.gov/
NASA_USERNAME=your_nasa_earthdata_username
NASA_PASSWORD=your_nasa_earthdata_password

# ── Scheduler intervals (giây) — tuỳ chỉnh nếu cần ──────────────────────────
INGESTION_INTERVAL_SECONDS=300     # 5 phút
ANALYSIS_INTERVAL_SECONDS=300      # 5 phút
PREDICTION_INTERVAL_SECONDS=300    # 5 phút
CLUSTERING_INTERVAL_SECONDS=86400  # 1 ngày

# ── Vùng dữ liệu mục tiêu: Bán đảo Nam Cực (Antarctic Peninsula) ───────────────
REGION_LAT_MIN=-70
REGION_LAT_MAX=-63
REGION_LON_MIN=-75
REGION_LON_MAX=-55

# ── Cấu hình Discovery Job (quét granule OMTO3G từ NASA) ──────────────────────
DISCOVERY_INTERVAL_SECONDS=7200    # 2 giờ
DISCOVERY_START_DATE=2026-11-16
