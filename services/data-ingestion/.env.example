# ── Data-Ingestion Service Environment ─────────────────────────────────────────

# URL kết nối trực tiếp PostgreSQL (để lưu dữ liệu vào bảng raw_measurements)
# Trong Docker container dùng host "postgres", khi chạy local trên máy dùng "localhost"
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/ozone_db

# Đường dẫn URL file HDF5/HE5 đầu vào seed/fallback (NASA OMTO3G)
NASA_DATA_URL=https://omisips1.omisips.eosdis.nasa.gov/data/10da43cd73977b549e32cd346b9f2a2f/OMI-Aura_L2G-OMTO3G_2026m1116_v004-2026m1117t052851.he5

# NASA Earthdata Credentials (tùy chọn - dùng khi tải link yêu cầu login)
NASA_USERNAME=your_nasa_earthdata_username
NASA_PASSWORD=your_nasa_earthdata_password

# Chu kỳ scheduler xử lý hàng đợi / discovery (giây)
INGESTION_INTERVAL_SECONDS=300

# Vùng dữ liệu mục tiêu: Bán đảo Nam Cực (Antarctic Peninsula)
REGION_LAT_MIN=-70
REGION_LAT_MAX=-63
REGION_LON_MIN=-75
REGION_LON_MAX=-55

# Cấu hình tự động quét tìm granule OMTO3G từ NASA (Discovery Job)
DISCOVERY_INTERVAL_SECONDS=7200
DISCOVERY_START_DATE=2026-11-16

# Thư mục lưu cookie tạm
COOKIE_JAR_PATH=/tmp/.urs_cookies
