# ── Backend-Services (Analysis + Clustering + Prediction) ─────────────────────
# URL của database-api (trong Docker dùng service name)
DATABASE_API_URL=http://database-api:8000

# Interval scheduler (giây)
ANALYSIS_INTERVAL_SECONDS=300      # 5 phút
PREDICTION_INTERVAL_SECONDS=300    # 5 phút
CLUSTERING_INTERVAL_SECONDS=86400  # 1 ngày
