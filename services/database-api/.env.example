# ── Database-API Service ───────────────────────────────────────────────────────
# PostgreSQL connection (trong Docker dùng service name "postgres")
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/ozone_db

# CORS: danh sách origins cho phép, phân cách bằng dấu phẩy
# Dùng * để cho phép tất cả (dev), hoặc http://localhost:3000 cho production
CORS_ORIGINS=*

# WebSocket background poll interval (giây)
WS_POLL_INTERVAL_SECONDS=30
