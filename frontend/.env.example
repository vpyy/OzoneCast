# ── OzoneCast Frontend Configuration ──────────────────────────────────────────
# URL của Database API (FastAPI Gateway)
VITE_DB_API_URL=http://localhost:8000

# WebSocket stream URL cho cập nhật thời gian thực
VITE_WS_URL=ws://localhost:8000/ws/stream

# Chế độ phát dữ liệu mẫu trực tiếp (phát 1 điểm mới mỗi 2 giây để kiểm tra hiệu ứng sàn chứng khoán mà không cần chờ nạp)
VITE_MOCK_LIVE=false

# Số phút cảnh báo dữ liệu cũ/đình trệ (mặc định 180 phút vì chu kỳ nạp là 2 giờ/lần)
VITE_LIVE_STALE_MINUTES=180
